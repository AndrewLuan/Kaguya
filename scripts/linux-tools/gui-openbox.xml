<!-- 应用 UID 的窗口管理器，仅固定终端快捷键；不读取共享 workspace 配置。 -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <keyboard><keybind key="A-F2"><action name="Execute"><command>/usr/bin/xterm</command></action></keybind></keyboard>
  <mouse><context name="Titlebar"><mousebind button="Left" action="Drag"><action name="Move"/></mousebind></context></mouse>
</openbox_config>
